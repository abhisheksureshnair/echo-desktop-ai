{
  "manifest_version": 2,
  "name": "Echo",
  "version": "1.0.0",
  "description": "Echo AI co-pilot sidebar built into every webpage.",
  "permissions": ["activeTab", "storage", "tabs", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_title": "Echo — Toggle Sidebar",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "echo-ai@innspark.app",
      "strict_min_version": "109.0"
    }
  }
}
